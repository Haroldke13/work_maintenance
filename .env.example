FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=jonyango
ADMIN_PASSWORD=field.123
DEFAULT_USER_PASSWORD=field.123
HELPDESK_MANAGER_USERNAME=ictmanager
HELPDESK_MANAGER_PASSWORD=field.123
HELPDESK_OFFICER_USERNAME=icthelpdesk
HELPDESK_OFFICER_PASSWORD=field.123
POSTGRES_DB=cleanup_practical
POSTGRES_USER=cleanup_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg2://cleanup_user:replace-with-a-strong-database-password@db:5432/cleanup_practical

# Email notifications — every submitted response is mailed to NOTIFY_EMAILS.
# MAIL_PASSWORD is a Gmail App Password, not the account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=replace-with-the-sending-gmail-address
MAIL_PASSWORD=replace-with-a-gmail-app-password
MAIL_SENDER_NAME=PBORA
MAIL_DEFAULT_SENDER=replace-with-the-sending-gmail-address
NOTIFY_EMAILS=jonyango@pbora.go.ke
ADMIN_EMAIL=jonyango@pbora.go.ke
SUPPORT_EMAIL=ictsupport@pbora.go.ke
